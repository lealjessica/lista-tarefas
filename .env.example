# ==============================================================================
# .env.example — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com valores reais no repositório!
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase (necessário apenas se migrar do LocalStorage para Supabase)
# Documentação: https://supabase.com/docs/guides/getting-started
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica-aqui

# ------------------------------------------------------------------------------
# Ambiente da Aplicação
# Valores possíveis: development | production | test
# ------------------------------------------------------------------------------
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# Nome da aplicação (opcional - sobrescreve o padrão)
# ------------------------------------------------------------------------------
VITE_APP_NAME=TaskFlow Pro
